{
  "name": "birchize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A thoughtful, local-first file studio. Made by Vargking.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pages": "npm run build && playwright test --config=playwright.pages.config.ts",
    "prepare:engines": "node scripts/engines.mjs",
    "postinstall": "node scripts/engines.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@zip.js/zip.js": "^2.8.11",
    "dompurify": "^3.2.7",
    "hash-wasm": "^4.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "libarchive.js": "^2.0.2",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
